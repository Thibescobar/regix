# ---------------------------------------------------------------------------
# PATIENT DATA AND RUN OUTPUTS: NEVER COMMIT
# A single DICOM slice left in a public repository is a health-data breach.
# These rules are deliberately broad.
# ---------------------------------------------------------------------------
*.dcm
*.DCM
*.nii
*.nii.gz
*.nrrd
*.nhdr
*.mha
*.mhd
*.raw
*.img
*.hdr
*.h5
*.tfm

# Output and data directories
e2e_out/
ci_out/
ci_figures/
regix_out*/
regix_batch*/
regix_masks*/
demo_data/
dataregix/
out/
output/
outputs/
data/
Fixed/
Moving/
**/dicom_registered/
**/elastix/
**/transformix/

# Reports and run logs (may contain patient slices)
report.html
run_manifest.json
regix.log
*.log
summary.csv

# Model weights: never redistributed (they carry their own licences)
model-weights/
*.pth
*.pt
*.ckpt

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

